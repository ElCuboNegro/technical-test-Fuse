{
  "description": "Contact information collection with invalid ZIP code that gets corrected on retry",
  "scenario": "invalid_zip_then_fix",
  "requirements": ["R5"],
  "conversation": [
    {
      "turn": 1,
      "speaker": "agent",
      "message": "Now I need your complete mailing address. Please provide your street address, including house or building number.",
      "context": {
        "identityVerified": true,
        "contactProgress": {
          "addressComplete": false,
          "emailComplete": false,
          "unitNumberAsked": false
        }
      }
    },
    {
      "turn": 2,
      "speaker": "user",
      "message": "I live at 1247 Oak Street, Denver, Colorado, 8020.",
      "extracted_data": {
        "street": "1247 Oak Street",
        "city": "Denver",
        "state": "Colorado",
        "zipCode": "8020"
      }
    },
    {
      "turn": 3,
      "speaker": "agent",
      "message": "I notice the ZIP code format appears incorrect. ZIP codes should be 5 digits like 12345 or 9 digits like 12345-6789. Can you please provide your complete ZIP code?",
      "context": {
        "error": {
          "code": "INVALID_ZIP_FORMAT",
          "recoverable": true,
          "field": "zipCode",
          "formatExample": "12345 or 12345-6789"
        }
      }
    },
    {
      "turn": 4,
      "speaker": "user",
      "message": "Oh sorry, it's 80202.",
      "extracted_data": {
        "street": "1247 Oak Street",
        "city": "Denver",
        "state": "CO",
        "zipCode": "80202"
      }
    },
    {
      "turn": 5,
      "speaker": "agent",
      "message": "Perfect! Your mailing address is 1247 Oak Street, Denver, Colorado, 8-0-2-0-2. Is that correct?",
      "context": {
        "addressComplete": true,
        "ttsFormatting": {
          "zipCode": "8-0-2-0-2"
        }
      }
    },
    {
      "turn": 6,
      "speaker": "user",
      "message": "Yes, that's correct."
    }
  ],
  "expected_state": {
    "collected": {
      "contact": {
        "address": {
          "street": "1247 Oak Street",
          "city": "Denver",
          "state": "CO",
          "zipCode": "80202"
        }
      }
    },
    "needs": {
      "identity": false,
      "contact": false,
      "financial": true,
      "confirm": false
    },
    "contactProgress": {
      "addressComplete": true,
      "emailComplete": false,
      "unitNumberAsked": false
    }
  },
  "expected_events": [
    {
      "node": "contact",
      "success": false,
      "reason": "INVALID_ZIP_FORMAT",
      "attempt_number": 1
    },
    {
      "node": "contact",
      "success": true,
      "attempt_number": 2
    }
  ]
}