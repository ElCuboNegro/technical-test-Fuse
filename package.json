{
  "name": "learning-multinode",
  "version": "0.4.4",
  "description": "Multi-node learning project with database seeding and migration system",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --run",
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "migrate": "node-pg-migrate",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create",
    "migrate:status": "node-pg-migrate status",
    "seed:test": "tsx src/database/cli/seed-cli.ts --env=test",
    "seed:clean": "tsx src/database/cli/seed-cli.ts clean --env=test",
    "seed:reset": "tsx src/database/cli/seed-cli.ts reset --env=test",
    "setup:test": "tsx src/database/cli/setup-cli.ts --env=test",
    "migrate:missing-tables": "tsx src/database/cli/migrate-cli.ts --env=test",
    "verify:tables": "tsx src/database/cli/verify-tables.ts --env=test",
    "test:data-structure": "tsx src/database/cli/test-data-structure.ts --env=test"
  },
  "keywords": [
    "database",
    "seeding",
    "migration",
    "postgresql",
    "testing"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.10.0",
    "jest": "^29.5.0",
    "node-pg-migrate": "^8.0.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "pg": "^8.11.0",
    "zod": "^3.22.0"
  }
}
