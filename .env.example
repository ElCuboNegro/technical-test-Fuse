# =============================================================================
# PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# Copy this file to .env and fill in the actual values
# This file contains all environment variables needed for production deployment

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
NODE_ENV=production
WEB_PORT=3000
AGENTS_PORT=2024

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL with pgvector)
# =============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=agents_app
POSTGRES_USER=app_user
POSTGRES_PASSWORD=your_secure_password_here

# Database URL (constructed from above values)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# Redis URL (constructed from above values)
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}

# =============================================================================
# AI SERVICE API KEYS
# =============================================================================
# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# LANGSMITH OBSERVABILITY CONFIGURATION
# =============================================================================
# LangSmith tracing for agent monitoring and debugging
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=your_langsmith_project_name



# =============================================================================
# VECTOR DATABASE CONFIGURATION
# =============================================================================
# Vector store: pgvector (PostgreSQL extension) - configured above with database settings
# No additional configuration needed for pgvector

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# JWT Secret for session management
JWT_SECRET=your_jwt_secret_key_here

# Session secret for Express sessions
SESSION_SECRET=your_session_secret_here

# =============================================================================
# LOGGING AND MONITORING
# =============================================================================
LOG_LEVEL=info
ENABLE_METRICS=true

# =============================================================================
# DOCKER SPECIFIC CONFIGURATION
# =============================================================================
# These are used by Docker Compose for service configuration
COMPOSE_PROJECT_NAME=multi-agent-ai