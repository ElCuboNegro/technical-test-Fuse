# =============================================================================
# DEVELOPMENT ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# Copy this file to .env.dev and fill in the actual values
# This file contains all environment variables needed for development

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
NODE_ENV=development
WEB_PORT=3000
AGENTS_PORT=2024

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL with pgvector)
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agents_app_dev
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=dev_password

# Database URL (constructed from above values)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
# Redis password for secure access (even in development)
REDIS_PASSWORD=dev_redis_secure_password_2024

# Redis URL (constructed from above values)
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}

# =============================================================================
# AI SERVICE API KEYS (Development/Testing)
# =============================================================================
# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# LANGSMITH OBSERVABILITY CONFIGURATION
# =============================================================================
# LangSmith tracing for agent monitoring and debugging
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=your_langsmith_project_name



# =============================================================================
# VECTOR DATABASE CONFIGURATION (Development)
# =============================================================================
# Vector store: pgvector (PostgreSQL extension) - configured above with database settings
# No additional configuration needed for pgvector

# =============================================================================
# SECURITY CONFIGURATION (Development)
# =============================================================================
# JWT Secret for session management (use a simple secret for dev)
JWT_SECRET=dev_jwt_secret_key

# Session secret for Express sessions (use a simple secret for dev)
SESSION_SECRET=dev_session_secret

# =============================================================================
# DEVELOPMENT SPECIFIC CONFIGURATION
# =============================================================================
# Logging and debugging
LOG_LEVEL=debug
ENABLE_METRICS=false

# Hot reloading and development features
ENABLE_HOT_RELOAD=true
ENABLE_DEBUG_MODE=true

# Development database settings
ENABLE_DB_LOGGING=true
ENABLE_DB_SYNC=true

# =============================================================================
# DOCKER DEVELOPMENT CONFIGURATION
# =============================================================================
# These are used by Docker Compose for development service configuration
COMPOSE_PROJECT_NAME=multi-agent-ai-dev

# Development specific Docker settings
ENABLE_VOLUME_MOUNTS=true
ENABLE_DEBUG_PORTS=true