{
  "enabled": false,
  "name": "Documentation Sync",
  "description": "Monitors all specs documentation and revises readme.md, and system_architecture.md are updated",
  "version": "1",
  "when": {
    "type": "userTriggered",
    "patterns": [
      "**/*.ts",
      "**/*.js",
      "**/*.tsx",
      "**/*.jsx",
      "**/*.json",
      "**/*.md",
      "**/*.yml",
      "**/*.yaml",
      "package.json",
      "tsconfig.json",
      "langgraph.json",
      "docker-compose*.yml",
      "eslint.config.js",
      "jest.config*.js",
      "turbo.json"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Source files have been modified in this TypeScript/JavaScript project. Please review the changes and update the documentation accordingly. If there is a /docs folder, system_architecture.md, or other specs being impacted with the changes update relevant documentation there. Otherwise, update the README.md file. Focus on:\n\n1. API changes or new endpoints\n2. New agent implementations or modifications\n3. Configuration changes\n4. New features or capabilities\n5. Updated dependencies or build processes\n6. Changes to the project structure\n\nEnsure the documentation reflects the current state of the codebase and maintains consistency with the established patterns for this multi-agent AI application built with LangGraph, Next.js, and TypeScript."
  }
}